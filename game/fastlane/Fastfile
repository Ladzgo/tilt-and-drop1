# Signs the Unity-exported Xcode project and uploads it to TestFlight.
# Uses an App Store Connect API key and fastlane match (certificates in a private git repo).
default_platform(:ios)

platform :ios do
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )
    setup_ci
    match(type: "appstore", readonly: true, api_key: api_key, app_identifier: "com.laszlo.tiltdrop", team_id: ENV["APPLE_TEAM_ID"])
    project = File.join(ENV["XCODE_PROJECT_DIR"], "Unity-iPhone.xcodeproj")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["Unity-iPhone"],
      code_sign_identity: "iPhone Distribution",
      profile_name: "match AppStore com.laszlo.tiltdrop"
    )
    increment_build_number(xcodeproj: project, build_number: (ENV["GITHUB_RUN_NUMBER"] || "1"))
    build_app(project: project, scheme: "Unity-iPhone", export_method: "app-store", output_directory: "../build/ipa")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
